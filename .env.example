# Discord application credentials (Developer Portal → your app)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# The server the bot runs in (slash commands are registered to this guild so they appear instantly)
GUILD_ID=

# Channels
ANNOUNCE_CHANNEL_ID=      # phase announcements + "share your moment" prompt
POLL_CHANNEL_ID=          # daily yearbook polls
YEARBOOK_CHANNEL_ID=      # final yearbook reveal
LOG_CHANNEL_ID=           # private mod/staff channel: poll results, warnings, reminders

# Optional
PING_ROLE_ID=             # role pinged on announcements/polls (leave empty for no ping)
ADMIN_ROLE_ID=            # role allowed to use /yb (members with Manage Server can always use it)
DATABASE_PATH=./data/yearbook.db

# Rehearsal only: pretend "now" is this date/time (in the config timezone) to dry-run the schedule.
# Leave empty in production!
# YEARBOOK_NOW=2026-11-09T11:59
