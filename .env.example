# Discord bot (Developer Portal → your app → Bot)
BOT_TOKEN=
# Your Discord user ID: always has access to /yb
BOT_OWNER_ID=
# The server the bot runs in (slash commands are registered to this guild so they appear instantly)
GUILD_ID=
# MongoDB connection string. Add a database name to choose one; otherwise "meovv-yearbook" is used.
MONGO_URI=

# Channels
ANNOUNCE_CHANNEL_ID=      # main event channel: announcements, "share your moment" prompt, the final yearbook
POLL_CHANNEL_ID=          # daily yearbook polls (can be the same channel)
LOG_CHANNEL_ID=           # private staff channel: every fan entry, staff actions, poll results, warnings

# Optional
PING_ROLE_ID=             # role pinged on announcements/polls (leave empty for no ping)
ADMIN_ROLE_ID=            # role allowed to use /yb (members with Manage Server can always use it)
TZ=America/Los_Angeles    # event timezone: every date and time in the config is read in this zone
LOG_LEVEL=info            # console detail: debug | info | warn | error

# Rehearsal only: pretend "now" is this date/time (in the event timezone) to dry-run the schedule.
# Leave empty in production!
# YEARBOOK_NOW=2026-11-09T11:59
